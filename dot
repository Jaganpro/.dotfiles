#!/bin/bash
# shellcheck disable=SC2088  # "~/" in messages is display text, not a path
# dot: manage this Mac's setup from ~/.dotfiles.
# Command layout inspired by dmmulroy/.dotfiles (https://github.com/dmmulroy/.dotfiles).
# Written for macOS's /bin/bash 3.2.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
HOME_PKG="$DOTFILES/home"
TILDE="~"   # bash 3.2 prints \~ literally inside ${var/pattern/\~}

ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*"; }
bad()  { printf '\033[31m✗\033[0m %s\n' "$*"; }
step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

usage() {
  cat <<'EOF'
Usage: dot <command>

  init [--no-macos]  Set up this Mac: packages, links, git hook, macOS and Rex settings
  doctor             Check that everything is linked, installed and committed
  update             Pull the repo, upgrade Homebrew packages, relink
  stow               Relink home/ into ~ (after adding or renaming files)
  add <file>...      Move files from ~ into the repo and link them back
  help               Show this help
EOF
}

# Every file in home/, as a path relative to ~ (e.g. .config/git/ignore)
tracked_files() { (cd "$HOME_PKG" && find . -type f | sed 's|^\./||' | sort); }

link_home() {
  # A real file where a link should go is moved to a backup, never overwritten
  local backup f
  backup="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"
  while IFS= read -r f; do
    if [[ -e "$HOME/$f" && ! -L "$HOME/$f" ]]; then
      mkdir -p "$backup/$(dirname "$f")"
      mv "$HOME/$f" "$backup/$f"
      warn "backed up ~/$f to ${backup/#$HOME/$TILDE}"
    fi
  done < <(tracked_files)
  # --no-folding: link files only, never whole folders (keeps app data out of git)
  stow --no-folding --restow --dir "$DOTFILES" --target "$HOME" home
  ok "home/ linked into ~"

  # Share every skill in skills/ with Claude Code (Pi finds them via its settings)
  local skill name
  mkdir -p "$HOME/.claude/skills"
  for skill in "$DOTFILES"/skills/*/; do
    [[ -f $skill/SKILL.md ]] || continue
    name=$(basename "$skill")
    if [[ -e "$HOME/.claude/skills/$name" && ! -L "$HOME/.claude/skills/$name" ]]; then
      warn "~/.claude/skills/$name is a real folder; not replacing it"
    else
      ln -sfn "${skill%/}" "$HOME/.claude/skills/$name"
    fi
  done
  ok "skills/ shared with Claude Code (~/.claude/skills)"

  # Share every prompt in prompts/ with Claude Code as a /command
  local prompt
  mkdir -p "$HOME/.claude/commands"
  for prompt in "$DOTFILES"/prompts/*.md; do
    [[ -e $prompt ]] || continue
    ln -sf "$prompt" "$HOME/.claude/commands/$(basename "$prompt")"
  done
  ok "prompts/ shared with Claude Code (~/.claude/commands)"
}

install_skill_deps() {
  # Agent skills in skills/ that ship a package.json need their node_modules
  local pkg dir
  for pkg in "$DOTFILES"/skills/*/package.json; do
    [[ -e $pkg ]] || continue
    dir=$(dirname "$pkg")
    step "Skill dependencies: skills/$(basename "$dir")"
    (cd "$dir" && npm ci --no-fund --no-audit --loglevel=error)
  done
}

# Agent skills installed by apps (packages/app-skills): "name|paths|how" per line
app_skills() {
  grep -v -E '^[[:space:]]*(#|$)' "$DOTFILES/packages/app-skills" 2>/dev/null |
    sed -E 's/[[:space:]]*\|[[:space:]]*/|/g'
}

# Homebrew 7 only loads third-party taps you trust; trust each `tap` in the Brewfile
trust_taps() {
  local tap
  sed -n 's/^tap "\(.*\)".*/\1/p' "$DOTFILES/packages/Brewfile" | while read -r tap; do
    brew trust --tap "$tap" >/dev/null
  done
}

cmd_init() {
  command -v brew >/dev/null || { bad "Install Homebrew first: https://brew.sh"; exit 1; }

  step "Packages (packages/Brewfile)"
  trust_taps
  brew bundle --file "$DOTFILES/packages/Brewfile" --no-upgrade

  step "Let zsh trust Homebrew's completion folders"
  chmod go-w "$(brew --prefix)/share"
  chmod -R go-w "$(brew --prefix)/share/zsh"

  step "Links"
  link_home
  mkdir -p "$HOME/.local/bin"
  ln -sf "$DOTFILES/dot" "$HOME/.local/bin/dot"
  ok "dot command available as ~/.local/bin/dot"

  install_skill_deps

  step "Lint tools (package.json)"
  (cd "$DOTFILES" && npm ci --no-fund --no-audit --loglevel=error)

  step "Git hook: checks (lint, shellcheck, secrets) run before every commit"
  git -C "$DOTFILES" config core.hooksPath scripts/hooks
  ok "pre-commit checks active"

  if [[ ${1:-} != --no-macos ]]; then
    step "macOS settings"
    "$DOTFILES/scripts/macos-defaults.sh"

    step "Rex settings (scripts/rex-settings.sh)"
    if [[ ! -d "/Applications/Rex Beta.app" ]]; then
      warn "Rex not installed (private beta); after installing it, quit it and run: ~/.dotfiles/scripts/rex-settings.sh"
    else
      # Not fatal: it refuses while Rex is open, and the rest of init should still finish.
      "$DOTFILES/scripts/rex-settings.sh" || warn "Rex settings not applied; quit Rex and run: ~/.dotfiles/scripts/rex-settings.sh"
    fi
  fi

  local name paths how
  while IFS='|' read -r name paths how; do
    warn "install by hand: $name skill: $how"
  done < <(app_skills)

  printf '\nDone. Open a new terminal to load the shell config, then run: dot doctor\n'
}

cmd_doctor() {
  local problems=0 f target n_links=0 n_plain=0 n_missing=0 n_other=0 broken l

  step "Tools"
  for f in brew stow git gitleaks; do
    if command -v "$f" >/dev/null; then ok "$f"; else bad "$f not installed"; problems=$((problems + 1)); fi
  done
  if [[ $(command -v dot || true) == "$HOME/.local/bin/dot" ]]; then ok "dot on PATH"; else warn "dot not on PATH (run: dot init)"; fi

  step "Links (home/ -> ~)"
  while IFS= read -r f; do
    target="$HOME/$f"
    if [[ -L $target ]]; then
      if [[ $target -ef "$HOME_PKG/$f" ]]; then   # -ef: the link resolves to the repo file
        n_links=$((n_links + 1))
      else
        bad "~/$f links somewhere else: $(readlink "$target")"; n_other=$((n_other + 1))
      fi
    elif [[ -e $target ]]; then
      bad "~/$f is a plain file, not a link (an app may have replaced it)"
      printf '    fix: compare with home/%s, keep the right one in home/, delete ~/%s, run: dot stow\n' "$f" "$f"
      n_plain=$((n_plain + 1))
    else
      bad "~/$f is missing (run: dot stow)"; n_missing=$((n_missing + 1))
    fi
  done < <(tracked_files)
  problems=$((problems + n_plain + n_missing + n_other))
  [[ $n_links -gt 0 ]] && ok "$n_links files linked"

  broken=0
  while IFS= read -r l; do
    bad "broken link: ${l/#$HOME/$TILDE} -> $(readlink "$l")"; broken=$((broken + 1))
  done < <(find "$HOME" -maxdepth 6 -type l -lname '*dotfiles/home/*' ! -exec test -e {} \; -print 2>/dev/null)
  problems=$((problems + broken))
  [[ $broken -eq 0 ]] && ok "no broken links"

  step "Packages"
  if brew bundle check --file "$DOTFILES/packages/Brewfile" --no-upgrade >/dev/null 2>&1; then
    ok "everything in the Brewfile is installed"
  else
    bad "Brewfile items missing:"
    brew bundle check --file "$DOTFILES/packages/Brewfile" --no-upgrade --verbose 2>&1 | grep '→' | sed 's/^/    /'
    problems=$((problems + 1))
  fi

  for f in "$DOTFILES"/skills/*/package.json; do
    [[ -e $f ]] || continue
    if [[ -d $(dirname "$f")/node_modules ]]; then ok "skills/$(basename "$(dirname "$f")") dependencies installed"
    else bad "skills/$(basename "$(dirname "$f")") dependencies missing (run: dot init --no-macos)"; problems=$((problems + 1)); fi
  done
  for f in "$DOTFILES"/skills/*/SKILL.md; do
    [[ -e $f ]] || continue
    n=$(basename "$(dirname "$f")")
    if [[ "$HOME/.claude/skills/$n" -ef "$(dirname "$f")" ]]; then ok "skills/$n shared with Claude Code"
    else bad "skills/$n not linked into ~/.claude/skills (run: dot stow)"; problems=$((problems + 1)); fi
  done
  for f in "$DOTFILES"/prompts/*.md; do
    [[ -e $f ]] || continue
    n=$(basename "$f")
    if [[ "$HOME/.claude/commands/$n" -ef "$f" ]]; then ok "prompt /${n%.md} shared with Claude Code"
    else bad "prompt /${n%.md} not linked into ~/.claude/commands (run: dot stow)"; problems=$((problems + 1)); fi
  done

  step "App-installed skills (packages/app-skills)"
  local name paths how path missing
  while IFS='|' read -r name paths how; do
    missing=""
    for path in $paths; do [[ -e ${path/#\~/$HOME} ]] || missing+=" $path"; done
    if [[ -z $missing ]]; then ok "$name"; else warn "$name missing:$missing"; printf '    fix: %s\n' "$how"; fi
  done < <(app_skills)

  step "Apps that need a sign-in"
  # Grok Bot creates its settings file when you finish its first-launch setup.
  if [[ ! -d "/Applications/Grok Bot.app" ]]; then
    warn "Grok Bot not installed (brew bundle --global)"
  elif [[ $(jq -r '.hasSeenOnboarding // false' "$HOME/.grokbot/settings.json" 2>/dev/null) == true ]]; then
    ok "Grok Bot set up"
  else
    warn "Grok Bot not set up yet"; printf '    fix: open it, sign in, quit, run: ~/.dotfiles/scripts/grokbot-settings.sh (docs/setup.md)\n'
  fi

  step "Repo"
  if [[ $(git -C "$DOTFILES" config --get core.hooksPath || true) == scripts/hooks ]]; then
    ok "pre-commit checks active"
  else
    bad "pre-commit hook off (run: dot init --no-macos)"; problems=$((problems + 1))
  fi
  n=$(git -C "$DOTFILES" status --porcelain | wc -l | tr -d ' ')
  if [[ $n -eq 0 ]]; then ok "no uncommitted changes"; else warn "$n uncommitted change(s): cd ~/.dotfiles && git status"; fi
  git -C "$DOTFILES" fetch -q 2>/dev/null || true
  n=$(git -C "$DOTFILES" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  [[ $n -gt 0 ]] && warn "$n commit(s) not pushed: cd ~/.dotfiles && git push"
  n=$(git -C "$DOTFILES" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
  [[ $n -gt 0 ]] && warn "$n new commit(s) on GitHub: dot update"

  echo
  if [[ $problems -eq 0 ]]; then ok "All good."; else bad "$problems problem(s) found."; exit 1; fi
}

cmd_update() {
  step "Repo"
  git -C "$DOTFILES" pull --ff-only
  step "Homebrew"
  brew update
  trust_taps
  brew bundle --file "$DOTFILES/packages/Brewfile" --no-upgrade
  brew upgrade
  install_skill_deps
  step "Links"
  link_home
}

cmd_add() {
  [[ $# -gt 0 ]] || { bad "Usage: dot add <file>..."; exit 1; }
  # Check first: if another link is already broken, stow would refuse and the
  # moved files would be left unlinked
  if ! stow --no-folding --restow --simulate --dir "$DOTFILES" --target "$HOME" home 2>/dev/null; then
    bad "Some existing links need fixing first. Nothing was moved. Run: dot doctor"
    exit 1
  fi
  local p abs rel
  for p in "$@"; do
    if [[ ! -e $p && ! -L $p ]]; then bad "$p: not found"; continue; fi
    abs="$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
    rel="${abs#"$HOME"/}"
    if [[ $abs != "$HOME"/* ]]; then bad "$p: only files inside ~ can be added"; continue; fi
    if [[ -L $abs ]]; then bad "$p: already a link"; continue; fi
    if [[ ! -f $abs ]]; then bad "$p: not a file (add the files inside a folder one by one)"; continue; fi
    if [[ -e "$HOME_PKG/$rel" ]]; then bad "$p: home/$rel already exists in the repo"; continue; fi
    mkdir -p "$HOME_PKG/$(dirname "$rel")"
    mv "$abs" "$HOME_PKG/$rel"
    ok "moved ~/$rel into home/$rel"
  done
  stow --no-folding --restow --dir "$DOTFILES" --target "$HOME" home
  ok "linked. Review and commit: cd ~/.dotfiles && git status"
}

case "${1:-help}" in
  init)   shift; cmd_init "$@" ;;
  doctor) cmd_doctor ;;
  update) cmd_update ;;
  stow)   link_home ;;
  add)    shift; cmd_add "$@" ;;
  help|-h|--help) usage ;;
  *) bad "Unknown command: $1"; echo; usage; exit 1 ;;
esac
