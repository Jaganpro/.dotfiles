#!/bin/sh
# Block commits that contain secrets (API keys, tokens, passwords).
# Enabled by install.sh: git config core.hooksPath scripts/hooks
# Skip once, only if it's a false alarm: git commit --no-verify
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); skipping secret scan" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
