#!/bin/sh
# Checks run before every commit; any failure refuses the commit. git-guard
# blocks --no-verify, so they always run. Enabled by `dot init`:
# git config core.hooksPath scripts/hooks
# `dot doctor` is not here: it checks this Mac (apps, links), not the code.
# shortcut: checks the working tree, not only what is staged; fine for a one-person repo.
cd "$(git rev-parse --show-toplevel)" || exit 1

fail() {
  echo "pre-commit: $1" >&2
  exit 1
}

zsh -n home/.zshrc || fail "syntax error in home/.zshrc"
shellcheck dot scripts/*.sh scripts/hooks/pre-commit home/.claude/statusline.sh home/.claude/hooks/*.sh home/.config/starship/*.sh home/.local/bin/annotate home/.local/bin/beside home/.local/bin/review ||
  fail "shellcheck found problems"
env -i HOME="$HOME" USER="$USER" TERM=xterm-256color zsh -lic exit >/dev/null 2>&1 ||
  fail "a fresh login shell does not start (run: zsh -lic exit)"
# Rex: check init.lua when Rex is installed (`rex` is only on PATH inside Rex).
rex=$(command -v rex || echo "$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex")
if [ -x "$rex" ]; then
  "$rex" --autostart=false config check home/.config/rex/init.lua >/dev/null ||
    fail "home/.config/rex/init.lua has errors (run: rex config check)"
fi
[ -d node_modules ] || fail "lint tools missing: run npm ci"
npx --no-install oxlint home/.pi/agent/extensions || fail "lint failed (npm run lint)"
gitleaks git --pre-commit --staged --redact --no-banner . || fail "gitleaks found a secret"
