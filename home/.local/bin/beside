#!/bin/bash
# beside: run a review TUI in a Rex split to the right of the agent. When it exits,
# whatever it printed on stdout is pasted into the agent's pane and submitted; nothing is
# sent if it printed nothing. Used by annotate and review in Claude Code (Pi runs them in
# its own terminal instead).
#   beside <command> [args...]    (the command draws on the terminal, feedback on stdout)
set -euo pipefail

# Second half, running inside the split: run the review, then hand its stdout to the agent pane.
if [[ ${1:-} == --send-to ]]; then
  agent=$2
  shift 2
  feedback=$("$@" || true)
  [[ -n $feedback ]] || exit 0
  # Bracketed paste, so a multi-line review arrives as one message instead of each
  # newline pressing Enter in the agent.
  rex send -b "$agent" $'\e[200~'"$feedback"$'\e[201~'
  rex send-key -b "$agent" enter
  rex block focus "$agent"
  exit 0
fi

if [[ ${TERM_PROGRAM:-} != rex || -z ${REX_BLOCK:-} ]]; then
  echo "Needs Rex: the review opens in a Rex split next to the agent." >&2
  exit 1
fi

# First half, in the agent's pane: open a split on the right that runs the second half.
# It closes by itself when the review ends.
rex split -c "$PWD" -- "$0" --send-to "$REX_BLOCK" "$@" >/dev/null
