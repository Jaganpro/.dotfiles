#!/bin/bash
# annotate: review an agent's reply or a plan file with plannotator-tui, in a Ghostty
# split to the right of the agent, and send the feedback back to the agent.
#   annotate             Claude Code's newest reply (in Claude, run it as `! annotate`)
#   annotate plan.md     a Markdown file
#   annotate <args>      any plannotator-tui arguments (Pi's /annotate passes its session)
# In the split: annotate, then S (send and close). The feedback is pasted into the agent's
# pane and submitted, and the split closes. E only copies; it is sent when you press q.
# Nothing is sent if you quit without sending.
set -euo pipefail

# Second half, running inside the split: review, then hand new feedback to the agent pane.
if [[ ${1:-} == --send-to ]]; then
  agent=$2
  shift 2
  before=$(pbpaste)
  plannotator-tui "$@" || true
  feedback=$(pbpaste)
  # plannotator copies its feedback (outside Herdr, "send" means copy); only forward a new review
  [[ $feedback != "$before" && $feedback == "# Annotations on "* ]] || exit 0
  osascript - "$agent" "$feedback" >/dev/null <<'APPLESCRIPT'
on run {agentId, feedback}
  tell application "Ghostty"
    set agent to terminal id agentId
    input text feedback to agent
    send key "enter" to agent
    focus agent
  end tell
end run
APPLESCRIPT
  exit 0
fi

if [[ ${TERM_PROGRAM:-} != ghostty ]]; then
  echo "annotate: needs Ghostty; run plannotator-tui ${*:-last} instead" >&2
  exit 1
fi

(( $# )) || set -- last --host claude --newest

# First half, in the agent's pane: remember this pane and open a split whose shell runs the
# second half straight away (ANNOTATE_REVIEW, the first thing ~/.zshrc checks), so there is
# no prompt or splash and the split closes when the review ends. (A split opened with a
# command instead waits for a key press after it exits.)
osascript - "$0" "$PWD" "$@" >/dev/null <<'APPLESCRIPT'
on run argv
  set {selfPath, workDir} to {item 1 of argv, item 2 of argv}
  tell application "Ghostty"
    set agent to focused terminal of selected tab of front window
    set cmd to quoted form of selfPath & " --send-to " & quoted form of (id of agent as text)
    repeat with arg in items 3 thru -1 of argv
      set cmd to cmd & " " & quoted form of (arg as text)
    end repeat
    set cfg to new surface configuration
    set initial working directory of cfg to workDir
    set environment variables of cfg to {"ANNOTATE_REVIEW=" & cmd}
    split agent direction right with configuration cfg
  end tell
end run
APPLESCRIPT
